# Copy to deploy/.env and fill in. Never commit the real .env.

# Domain pointing (A/AAAA record) to this VPS. Caddy gets a Let's Encrypt certificate for it.
DOMAIN=finance.example.com

# Use letters and digits only (it is embedded into a connection string): openssl rand -hex 24
POSTGRES_PASSWORD=

# At least 32 characters: openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional
# POSTGRES_DB=smallney
# POSTGRES_USER=smallney
# RATES_BACKFILL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=20
