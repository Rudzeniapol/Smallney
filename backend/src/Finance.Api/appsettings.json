{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5445;Database=smallney;Username=smallney;Password=smallney"
  },
  "Jwt": {
    "Issuer": "smallney",
    "Audience": "smallney-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Hangfire": {
    "Enabled": true
  },
  "ExchangeRates": {
    "NbrbBaseUrl": "https://api.nbrb.by/",
    "Cron": "15 */6 * * *",
    "BackfillDays": 30
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    }
  },
  "AllowedHosts": "*"
}
